    <!-- ================== -->
    <!-- Object Properties -->
    <!-- ================== -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/hasDisabilityProfile">
        <rdfs:label>장애 정보를 가진다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Participant"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/DisabilityProfile"/>
        <rdfs:comment>장애 정보를 가진다</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>participant</ont:fromEntityId>
        <ont:toEntityId>disabilityProfile</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/hasBenefitStatus">
        <rdfs:label>수급 현황을 가진다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Participant"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/BenefitStatus"/>
        <rdfs:comment>수급 현황을 가진다</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>participant</ont:fromEntityId>
        <ont:toEntityId>benefitStatus</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/actsFor">
        <rdfs:label>대리한다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Proxy"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Participant"/>
        <rdfs:comment>대리한다 — 대리인이 당사자를 대신한다. 관계(부·모·형제·활동지원사 등)를 속성으로 함께 기록한다.</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>proxy</ont:fromEntityId>
        <ont:toEntityId>participant</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/submits">
        <rdfs:label>신청한다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Participant"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Application"/>
        <rdfs:comment>신청한다 — ★ 신청의 주체는 당사자다. 대리 서명이 있어도 신청인은 당사자로 남는다.</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>participant</ont:fromEntityId>
        <ont:toEntityId>application</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/cosigns">
        <rdfs:label>대리 서명한다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Proxy"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Application"/>
        <rdfs:comment>대리 서명한다</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>proxy</ont:fromEntityId>
        <ont:toEntityId>application</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/grants">
        <rdfs:label>동의한다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Participant"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/ConsentRecord"/>
        <rdfs:comment>동의한다 — ★ 동의의 주체도 당사자다. 대리인이 대신 체크한 경우 그 사실 자체를 속성으로 남긴다.</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>participant</ont:fromEntityId>
        <ont:toEntityId>consentRecord</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/includesConsent">
        <rdfs:label>동의서를 포함한다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Application"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/ConsentRecord"/>
        <rdfs:comment>동의서를 포함한다</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>application</ont:fromEntityId>
        <ont:toEntityId>consentRecord</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/receivedBy">
        <rdfs:label>접수된다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Application"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/ExecutingAgency"/>
        <rdfs:comment>접수된다</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>application</ont:fromEntityId>
        <ont:toEntityId>executingAgency</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/resultsIn">
        <rdfs:label>선정 결과로 이어진다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Application"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/SelectionDecision"/>
        <rdfs:comment>선정 결과로 이어진다</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>application</ont:fromEntityId>
        <ont:toEntityId>selectionDecision</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/decidedBy">
        <rdfs:label>선정을 결정한다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/SelectionDecision"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/AdministeringBody"/>
        <rdfs:comment>결정 주체</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>selectionDecision</ont:fromEntityId>
        <ont:toEntityId>administeringBody</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/authors">
        <rdfs:label>계획을 세운다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Participant"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/UtilizationPlan"/>
        <rdfs:comment>계획을 세운다 — ★ 계획의 저자는 참여자다. 개인예산제는 &quot;본인이 스스로 계획·선택·구매&quot;하는 제도이므로 이 화살표가 없으면 제도의 전제가 데이터에서 사라진다.</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>participant</ont:fromEntityId>
        <ont:toEntityId>utilizationPlan</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/assists">
        <rdfs:label>계획 수립을 돕는다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Caseworker"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/UtilizationPlan"/>
        <rdfs:comment>계획 수립을 돕는다 — 돕는 것이지 대신 세우는 것이 아니다. authors 와 짝을 이룬다.</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>caseworker</ont:fromEntityId>
        <ont:toEntityId>utilizationPlan</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/basedOn">
        <rdfs:label>신청서에 근거한다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/UtilizationPlan"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Application"/>
        <rdfs:comment>신청서에 근거한다</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>utilizationPlan</ont:fromEntityId>
        <ont:toEntityId>application</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/describes">
        <rdfs:label>나의 상황을 담는다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/UtilizationPlan"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/SelfNarrative"/>
        <rdfs:comment>나의 상황을 담는다</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>utilizationPlan</ont:fromEntityId>
        <ont:toEntityId>selfNarrative</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/requests">
        <rdfs:label>서비스를 요청한다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/UtilizationPlan"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/RequestedService"/>
        <rdfs:comment>서비스를 요청한다</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>utilizationPlan</ont:fromEntityId>
        <ont:toEntityId>requestedService</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/informs">
        <rdfs:label>서비스 선택의 근거가 된다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/SelfNarrative"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/RequestedService"/>
        <rdfs:comment>서비스 선택의 근거가 된다 — ★ 서울형에서 철학과 지출을 잇는 유일한 화살표. &quot;원하는 삶의 모습&quot;과 &quot;요청 서비스&quot;가 이어지지 않으면 심의가 근거 없이 판단하게 된다. pcp_ontology 의 justifiesExpense 에 해당하는 자리다.</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>selfNarrative</ont:fromEntityId>
        <ont:toEntityId>requestedService</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/classifiedAs">
        <rdfs:label>영역으로 분류된다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/RequestedService"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/ServiceDomain"/>
        <rdfs:comment>영역으로 분류된다</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>requestedService</ont:fromEntityId>
        <ont:toEntityId>serviceDomain</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/reviewedBy">
        <rdfs:label>심의를 받는다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/UtilizationPlan"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/PlanReview"/>
        <rdfs:comment>심의를 받는다</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>utilizationPlan</ont:fromEntityId>
        <ont:toEntityId>planReview</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/conductedBy">
        <rdfs:label>심의를 맡는다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/PlanReview"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/ReviewCommittee"/>
        <rdfs:comment>심의 주체</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>planReview</ont:fromEntityId>
        <ont:toEntityId>reviewCommittee</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/issues">
        <rdfs:label>통지를 발송한다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/PlanReview"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Notification"/>
        <rdfs:comment>통지를 발송한다</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>planReview</ont:fromEntityId>
        <ont:toEntityId>notification</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/sentTo">
        <rdfs:label>통지받는다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Notification"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Participant"/>
        <rdfs:comment>통지받는다</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>notification</ont:fromEntityId>
        <ont:toEntityId>participant</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/files">
        <rdfs:label>이의를 제기한다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Participant"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Appeal"/>
        <rdfs:comment>이의를 제기한다 — ★ 참여자 본인이 제기하는 것이 원칙. 화살표 방향이 곧 권리의 소재다.</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>participant</ont:fromEntityId>
        <ont:toEntityId>appeal</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/contests">
        <rdfs:label>통지에 이의를 단다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Appeal"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Notification"/>
        <rdfs:comment>통지에 이의를 단다 — 이의신청은 심의가 아니라 &quot;통지&quot;를 대상으로 건다. 통지일이 기산점이기 때문이다.</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>appeal</ont:fromEntityId>
        <ont:toEntityId>notification</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/appealReviewedBy">
        <rdfs:label>이의신청을 재심한다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Appeal"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/ReviewCommittee"/>
        <rdfs:comment>이의신청을 재심한다</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>appeal</ont:fromEntityId>
        <ont:toEntityId>reviewCommittee</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/authorizes">
        <rdfs:label>예산을 승인한다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/PlanReview"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/BudgetAllocation"/>
        <rdfs:comment>예산을 승인한다</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>planReview</ont:fromEntityId>
        <ont:toEntityId>budgetAllocation</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/allocatedTo">
        <rdfs:label>배정된다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/BudgetAllocation"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Participant"/>
        <rdfs:comment>배정된다</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>budgetAllocation</ont:fromEntityId>
        <ont:toEntityId>participant</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/fundedBy">
        <rdfs:label>재원을 댄다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/BudgetAllocation"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/AdministeringBody"/>
        <rdfs:comment>재원을 댄다</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>budgetAllocation</ont:fromEntityId>
        <ont:toEntityId>administeringBody</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/uses">
        <rdfs:label>서비스를 이용한다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Participant"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/ServiceUsage"/>
        <rdfs:comment>서비스를 이용한다 — ★ 이용의 주체도 당사자다. 실무자가 대신 입력했더라도 이용자는 당사자로 기록하고, 누가 입력·결정했는지는 속성으로 구분한다.</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>participant</ont:fromEntityId>
        <ont:toEntityId>serviceUsage</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/drawsFrom">
        <rdfs:label>예산에서 차감된다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/ServiceUsage"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/BudgetAllocation"/>
        <rdfs:comment>예산에서 차감된다</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>serviceUsage</ont:fromEntityId>
        <ont:toEntityId>budgetAllocation</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/fulfills">
        <rdfs:label>계획 항목을 이행한다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/ServiceUsage"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/RequestedService"/>
        <rdfs:comment>계획 항목을 이행한다 — ★ 이용 제한 요건 &quot;개인별 수립한 이용계획에 포함되어야 한다&quot;를 검사하는 화살표. 이 연결이 비어 있는 지출이 곧 검토 대상이다.</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>serviceUsage</ont:fromEntityId>
        <ont:toEntityId>requestedService</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/providedBy">
        <rdfs:label>제공처</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/ServiceUsage"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/ServiceProvider"/>
        <rdfs:comment>제공처</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>serviceUsage</ont:fromEntityId>
        <ont:toEntityId>serviceProvider</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/inDomain">
        <rdfs:label>영역에 속한다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/ServiceUsage"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/ServiceDomain"/>
        <rdfs:comment>영역에 속한다</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>serviceUsage</ont:fromEntityId>
        <ont:toEntityId>serviceDomain</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/evidencedBy">
        <rdfs:label>영수증으로 증빙된다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/ServiceUsage"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Receipt"/>
        <rdfs:comment>영수증으로 증빙된다</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>serviceUsage</ont:fromEntityId>
        <ont:toEntityId>receipt</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/issuedBy">
        <rdfs:label>발행처</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Receipt"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/ServiceProvider"/>
        <rdfs:comment>발행처</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>receipt</ont:fromEntityId>
        <ont:toEntityId>serviceProvider</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/checkedAgainst">
        <rdfs:label>규칙 검증을 거친다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/ServiceUsage"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/RuleCheck"/>
        <rdfs:comment>규칙 검증을 거친다</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>serviceUsage</ont:fromEntityId>
        <ont:toEntityId>ruleCheck</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/appliesRule">
        <rdfs:label>적용된 규칙</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/RuleCheck"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/SpendingRule"/>
        <rdfs:comment>적용된 규칙</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>ruleCheck</ont:fromEntityId>
        <ont:toEntityId>spendingRule</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/restrictsDomain">
        <rdfs:label>영역을 제한한다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/SpendingRule"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/ServiceDomain"/>
        <rdfs:comment>영역을 제한한다 — 규칙이 특정 영역에만 적용될 때 연결한다(예: 주거환경개선의 공사비 상한). 전역 규칙은 이 연결이 없다.</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>spendingRule</ont:fromEntityId>
        <ont:toEntityId>serviceDomain</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/monitors">
        <rdfs:label>모니터링을 수행한다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Caseworker"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/MonitoringRecord"/>
        <rdfs:comment>모니터링을 수행한다</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>caseworker</ont:fromEntityId>
        <ont:toEntityId>monitoringRecord</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/observes">
        <rdfs:label>대상 참여자</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/MonitoringRecord"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Participant"/>
        <rdfs:comment>대상 참여자</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>monitoringRecord</ont:fromEntityId>
        <ont:toEntityId>participant</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/reviewsUsage">
        <rdfs:label>이용 내역을 확인한다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/MonitoringRecord"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/ServiceUsage"/>
        <rdfs:comment>이용 내역을 확인한다</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>monitoringRecord</ont:fromEntityId>
        <ont:toEntityId>serviceUsage</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/settles">
        <rdfs:label>예산을 정산한다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Settlement"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/BudgetAllocation"/>
        <rdfs:comment>예산을 정산한다</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>settlement</ont:fromEntityId>
        <ont:toEntityId>budgetAllocation</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/aggregates">
        <rdfs:label>이용 내역을 집계한다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Settlement"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/ServiceUsage"/>
        <rdfs:comment>이용 내역을 집계한다</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>settlement</ont:fromEntityId>
        <ont:toEntityId>serviceUsage</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/verifiedBy">
        <rdfs:label>검증 기관</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Settlement"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/ExecutingAgency"/>
        <rdfs:comment>검증 기관</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>settlement</ont:fromEntityId>
        <ont:toEntityId>executingAgency</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/employedBy">
        <rdfs:label>소속 기관</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Caseworker"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/ExecutingAgency"/>
        <rdfs:comment>소속 기관</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>caseworker</ont:fromEntityId>
        <ont:toEntityId>executingAgency</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/designatedBy">
        <rdfs:label>지정 주체</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/ExecutingAgency"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/AdministeringBody"/>
        <rdfs:comment>지정 주체</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>executingAgency</ont:fromEntityId>
        <ont:toEntityId>administeringBody</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/assignedTo">
        <rdfs:label>담당자가 배정된다</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Participant"/>
        <rdfs:range rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Caseworker"/>
        <rdfs:comment>담당자가 배정된다</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>participant</ont:fromEntityId>
        <ont:toEntityId>caseworker</ont:toEntityId>
    </owl:ObjectProperty>

</rdf:RDF>
