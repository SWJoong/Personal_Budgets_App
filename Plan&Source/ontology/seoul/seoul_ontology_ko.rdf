        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/BenefitStatus"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>서울시 활동지원 추가지원 이용여부</rdfs:comment>
