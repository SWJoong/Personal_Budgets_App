        <rdfs:comment>담당자명</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/caseworker_caseworkerId">
        <rdfs:label>담당자 식별자</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/seoul-personal-budget-scheme-ontology/Caseworker"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>담당자 식별자 — 고유 식별자. SQL 의 id UUID PRIMARY KEY 에 대응한다.</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
