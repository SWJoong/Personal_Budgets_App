        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>공공부조 수급현황 — basic_livelihood(기초생활수급) | near_poor(차상위·조건부수급) | none(해당없음)</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/benefitStatus_usesActivitySupport">
