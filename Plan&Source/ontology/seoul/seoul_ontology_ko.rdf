        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>시범사업 차수 — 1차(2024) | 2차(2025) | 3차(2026). ★ 차수마다 한도액과 세부 규칙이 달라지므로 반드시 기록한다.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/seoul-personal-budget-scheme-ontology/application_applicantSignature">
        <rdfs:label>신청자 서명</rdfs:label>
