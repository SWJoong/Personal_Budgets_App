<?xml version="1.0" encoding="UTF-8"?>
<!--
  개인예산·사람중심계획(PCP) 사례관리 온톨로지 — RDF/OWL

  용도: Microsoft Ontology Playground (https://microsoft.github.io/Ontology-Playground/#/designer)
        에서 [Load in Playground] 또는 [Edit RDF] 로 붙여넣어 노드-엣지 다이어그램으로 확인합니다.
        코딩을 모르는 사례관리자와 개발자가 같은 그림을 보며 누락된 관계를 점검하는 것이 목적입니다.

  읽는 법:
    · Entity Types (owl:Class)        = 동그라미 — 사람·가치·자원·예산 등 "무엇이 있는가"
    · Object Properties               = 화살표   — 그것들이 "어떻게 연결되는가"
    · Data Properties                 = 속성     — 각 동그라미가 "무엇을 기록하는가"
    · rdfs:comment 의 [테이블: xxx]     = 현재 Supabase DB의 대응 테이블 (기존/신규 표시)

  설계 근거:
    Plan&Source/온톨로지_사례관리_개편_검토보고서_v1.md   (1차: 개편 방향)
    Plan&Source/서식_이질성_해결방안_v1.md                 (2차: 기관·사업별 서식 대응)
    Plan&Source/ontology/ontology_schema_draft.sql        (SQL 스키마 초안)
-->
<rdf:RDF
    xml:base="http://armdeuri.kr/ontology/pcp"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:ont="http://armdeuri.kr/ontology/pcp#">

    <owl:Ontology rdf:about="http://armdeuri.kr/ontology/pcp">
        <rdfs:label xml:lang="ko">개인예산·사람중심계획 사례관리 온톨로지</rdfs:label>
        <rdfs:label xml:lang="en">Personal Budget &amp; Person-Centered Planning Case Management Ontology</rdfs:label>
        <rdfs:comment xml:lang="ko">발달장애인 개인예산제와 사람중심계획(PCP)을 함께 지원하기 위한 사례관리 온톨로지. 기관·사업마다 서식이 달라도 의미는 하나로 모이도록, 서식이 아니라 의미를 모델링한다.</rdfs:comment>
    </owl:Ontology>

    <!-- ======================================================= -->
    <!-- Entity Types (Classes)                                  -->
    <!-- ======================================================= -->

    <!-- ── 사람 ───────────────────────────────────────────── -->

    <owl:Class rdf:about="#Person">
        <rdfs:label xml:lang="ko">당사자</rdfs:label>
        <rdfs:label xml:lang="en">Person</rdfs:label>
        <rdfs:comment xml:lang="ko">장애인 당사자. 개인예산의 소비자이자 삶의 주체. [기존 테이블: participants + profiles]</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Supporter">
        <rdfs:label xml:lang="ko">지원자</rdfs:label>
        <rdfs:label xml:lang="en">Supporter</rdfs:label>
        <rdfs:comment xml:lang="ko">사례관리팀·사회복지 실무자·PCP 퍼실리테이터. [기존 테이블: profiles(role=supporter|admin)]</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#NetworkEntity">
        <rdfs:label xml:lang="ko">지역사회 관계망</rdfs:label>
        <rdfs:label xml:lang="en">Network Entity</rdfs:label>
        <rdfs:comment xml:lang="ko">당사자의 삶에 있는 사람들. 사람중심계획의 관계 지도(Relationship Map) 4분면 — 가족 / 친구 / 유급 지원자 / 직장·학교·지역사회 — 으로 나뉜다. 4분면으로 나누는 이유는 분류 자체가 아니라 관계의 균형이 깨졌는지를 보기 위함이다. 유급 지원자만 남고 무급 관계가 비면 그것이 고립 신호다. [신규 테이블: network_entities, relation_category 컬럼으로 4분면 구분]</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Family">
        <rdfs:subClassOf rdf:resource="#NetworkEntity"/>
        <rdfs:label xml:lang="ko">가족</rdfs:label>
        <rdfs:label xml:lang="en">Family</rdfs:label>
        <rdfs:comment xml:lang="ko">부모·형제자매·조부모·친척. [relation_category=family]</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Friend">
        <rdfs:subClassOf rdf:resource="#NetworkEntity"/>
        <rdfs:label xml:lang="ko">친구</rdfs:label>
        <rdfs:label xml:lang="en">Friend</rdfs:label>
        <rdfs:comment xml:lang="ko">친구·이웃 등 스스로 선택한 무급 관계. 이 분면이 비어 있는 것이 가장 흔한 고립 양상이다. [relation_category=friend]</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#PaidSupport">
        <rdfs:subClassOf rdf:resource="#NetworkEntity"/>
        <rdfs:label xml:lang="ko">유급 지원자</rdfs:label>
        <rdfs:label xml:lang="en">Paid Support</rdfs:label>
        <rdfs:comment xml:lang="ko">돈을 받고 내 삶에 있는 사람 — 활동지원사·치료사·사회복지사. 기관 소속 실무자와 동일인이면 network_entities.linked_profile_id 로 지원자 계정과 연결한다. [relation_category=paid_support]</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#CommunityMember">
        <rdfs:subClassOf rdf:resource="#NetworkEntity"/>
        <rdfs:label xml:lang="ko">직장·학교·지역사회 사람</rdfs:label>
        <rdfs:label xml:lang="en">Community Member</rdfs:label>
        <rdfs:comment xml:lang="ko">직장 동료·학교 선생님과 동급생·단골 가게 주인 등 일상에서 마주치는 사람. 무급이지만 친구와는 구분되는 느슨한 연결. [relation_category=community]</rdfs:comment>
    </owl:Class>

    <!-- ── 가치·욕구 (PCP의 심장부) ────────────────────────── -->

    <owl:Class rdf:about="#ValueNode">
        <rdfs:label xml:lang="ko">가치·욕구 노드</rdfs:label>
        <rdfs:label xml:lang="en">Value Node</rdfs:label>
        <rdfs:comment xml:lang="ko">PCP 철학을 반영하는 핵심 추상 노드. 아래 8종 하위 클래스로 나뉜다. 보건복지부형·서울형·기관 자체 ISP의 질문이 모두 이 노드로 착지하므로, 서식이 달라도 의미는 한곳에 모인다. [신규 테이블: value_nodes, kind 컬럼으로 하위클래스 구분]</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ImportantTo">
        <rdfs:subClassOf rdf:resource="#ValueNode"/>
        <rdfs:label xml:lang="ko">나에게 중요한 것</rdfs:label>
        <rdfs:label xml:lang="en">Important To</rdfs:label>
        <rdfs:comment xml:lang="ko">당사자가 스스로 원하고 선호하며 애착을 가지는 것. [kind=important_to] 착지 서식: 복지부 "내 삶에서 가장 원하는 것", 아름드리 "나에게 중요한 것"</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ImportantFor">
        <rdfs:subClassOf rdf:resource="#ValueNode"/>
        <rdfs:label xml:lang="ko">나를 위해 중요한 것</rdfs:label>
        <rdfs:label xml:lang="en">Important For</rdfs:label>
        <rdfs:comment xml:lang="ko">건강·안전 등 전문가 관점에서 필요한 조치. [kind=important_for] 착지 서식: 복지부 "변화를 위해 필요한 지원", 아름드리 "나를 위해 중요한 것"</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Strength">
        <rdfs:subClassOf rdf:resource="#ValueNode"/>
        <rdfs:label xml:lang="ko">강점·재능</rdfs:label>
        <rdfs:label xml:lang="en">Strength</rdfs:label>
        <rdfs:comment xml:lang="ko">당사자의 재능·강점·기술. 강점 기반 실천의 출발점. [kind=strength] 착지 서식: 서울형 "나의 재능, 강점, 기술" — 1차 설계에서 착지할 곳이 없어 추가된 노드</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Dream">
        <rdfs:subClassOf rdf:resource="#ValueNode"/>
        <rdfs:label xml:lang="ko">꿈·원하는 삶의 모습</rdfs:label>
        <rdfs:label xml:lang="en">Dream</rdfs:label>
        <rdfs:comment xml:lang="ko">희망·꿈·관심사와 1~2년 내 시도하고 싶은 것. PATH(꿈 찾기) 산출물의 착지점. [kind=dream] 착지 서식: 서울형 "내가 원하는 삶의 모습", "시도하고 싶은 것"</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Barrier">
        <rdfs:subClassOf rdf:resource="#ValueNode"/>
        <rdfs:label xml:lang="ko">장벽·어려움</rdfs:label>
        <rdfs:label xml:lang="en">Barrier</rdfs:label>
        <rdfs:comment xml:lang="ko">장애로 인한 사회적 제한과 삶의 어려움. 개인의 결함이 아니라 환경적 장벽으로 기록한다. [kind=barrier] 착지 서식: 복지부 "가장 불편한 점", 서울형 "장애로 인해 겪는 사회적 제한"</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#CommunicationStyle">
        <rdfs:subClassOf rdf:resource="#ValueNode"/>
        <rdfs:label xml:lang="ko">소통 방식</rdfs:label>
        <rdfs:label xml:lang="en">Communication Style</rdfs:label>
        <rdfs:comment xml:lang="ko">당사자가 무엇을 어떻게 표현하는지 — 언어·비언어 의사소통 방식. Essential Lifestyle Planning의 핵심 요소이며 발달장애인 지원에 필수. 현행 세 서식 어디에도 없으나 실천상 반드시 필요. [kind=communication]</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#SupportApproach">
        <rdfs:subClassOf rdf:resource="#ValueNode"/>
        <rdfs:label xml:lang="ko">좋은 지원 / 피해야 할 것</rdfs:label>
        <rdfs:label xml:lang="en">What Works / What Doesn't</rdfs:label>
        <rdfs:comment xml:lang="ko">당사자에게 잘 맞는 지원 방식과 피해야 할 방식. 실무자가 바뀌어도 지원의 질이 유지되게 하는 암묵지의 명시화. [kind=what_works | what_doesnt]</rdfs:comment>
    </owl:Class>

    <!-- ── 과정: 회의·사정·평가 (PCT 순환의 뼈대) ──────────── -->

    <owl:Class rdf:about="#PlanningMeeting">
        <rdfs:label xml:lang="ko">사람중심 회의</rdfs:label>
        <rdfs:label xml:lang="en">Planning Meeting</rdfs:label>
        <rdfs:comment xml:lang="ko">PCD 회의·PATH(꿈 찾기)·계획 수립 회의·평가회. 가치·욕구는 저절로 생기지 않고 당사자와 주변 사람들이 함께 모여 알아가는 과정에서 나온다. 그 과정 자체를 기록하지 않으면 "누가 이 계획을 만들었는가"에 답할 수 없다. 당사자가 이 회의에 참여했는지 여부가 주도성의 1차 지표다. [신규 테이블: planning_meetings + planning_meeting_attendees]</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#SupportNeedsAssessment">
        <rdfs:label xml:lang="ko">지원요구 사정 (SIS-A)</rdfs:label>
        <rdfs:label xml:lang="en">Support Needs Assessment</rdfs:label>
        <rdfs:comment xml:lang="ko">지원정도척도 SIS-A 평가. 개별지원계획을 세울 때 "왜 이 영역에 이만큼의 지원이 필요한가"를 뒷받침하는 객관적 근거. PCD가 당사자의 주관적 선호를 담는다면 SIS-A는 지원 필요도를 측정한다 — 둘이 함께여야 To와 For의 균형이 근거를 갖는다. [기존 테이블: sis_assessments]</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Evaluation">
        <rdfs:label xml:lang="ko">월별 평가 (4+1)</rdfs:label>
        <rdfs:label xml:lang="en">Evaluation</rdfs:label>
        <rdfs:comment xml:lang="ko">사람중심생각(PCT)의 4+1 질문 — 시도한 것 / 배운 것 / 만족한 것 / 불만족한 것 / 향후 계획. 이 노드가 없으면 "무엇이 달라졌는가"를 기록할 곳이 없다. 평가에서 새로 알게 된 것은 다시 가치·욕구 노드가 되어 순환이 닫힌다(배움 기록 Learning Log 역할). [기존 테이블: evaluations + goal_evaluations]</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#OutcomeSnapshot">
        <rdfs:label xml:lang="ko">성과 스냅샷</rdfs:label>
        <rdfs:label xml:lang="en">Outcome Snapshot</rdfs:label>
        <rdfs:comment xml:lang="ko">월별 평가 시점의 지표를 고정해 둔 것 — To/For 균형, 관계 지도 4분면 인원, 주도성 비율, 방문 자원 다양도. **변화 측정의 실체.** 뷰가 아니라 저장하는 이유: 나중에 관계망을 정리하거나 가치를 보관 처리해도 3월 스냅샷은 3월의 값이어야 추이가 의미를 갖기 때문. [신규 테이블: outcome_snapshots]</rdfs:comment>
    </owl:Class>

    <!-- ── 자원·예산·집행 ─────────────────────────────────── -->

    <owl:Class rdf:about="#ServiceResource">
        <rdfs:label xml:lang="ko">서비스 자원·용처</rdfs:label>
        <rdfs:label xml:lang="en">Service Resource</rdfs:label>
        <rdfs:comment xml:lang="ko">지역 내 서비스 제공기관과 활동 장소. 현행 transactions.place_name 자유 텍스트의 엔티티 승격. [신규 테이블: service_resources]</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#BudgetPlan">
        <rdfs:label xml:lang="ko">예산 계획·ISP</rdfs:label>
        <rdfs:label xml:lang="en">Budget Plan / ISP</rdfs:label>
        <rdfs:comment xml:lang="ko">당사자가 수립하고 심의위원회가 승인한 자기주도지원계획과 예산(아름드리 기준 연 150만원). 개인예산제 7단계(신청→욕구상담→계획작성→심의승인→지급→집행모니터링→정산평가) 상태를 포함. **저자는 당사자다** — 지원자는 퍼실리테이터일 뿐이며, 이 사실이 authors 관계로 그래프에 명시된다. [기존: care_plans + budget_line_items / 신규: budget_cycles]</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#MonthlyPlan">
        <rdfs:label xml:lang="ko">월별 계획</rdfs:label>
        <rdfs:label xml:lang="en">Monthly Plan</rdfs:label>
        <rdfs:comment xml:lang="ko">연간 개별지원계획을 그 달에 실제로 무엇을 할지로 쪼갠 것. 연간 ISP와 개별 집행 사이를 잇는 고리이며, 월 단위로 당사자가 계획을 세우는 자리이기도 하다. [기존 테이블: monthly_plans]</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Transaction">
        <rdfs:label xml:lang="ko">집행 내역</rdfs:label>
        <rdfs:label xml:lang="en">Transaction</rdfs:label>
        <rdfs:comment xml:lang="ko">개인예산이 실제 지출된 개별 이벤트 — 영수증·날짜·품목. [기존 테이블: transactions]</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#RestrictionRule">
        <rdfs:label xml:lang="ko">제한 규칙</rdfs:label>
        <rdfs:label xml:lang="en">Restriction Rule</rdfs:label>
        <rdfs:comment xml:lang="ko">도박·주류·담배 등 오남용 차단 기준. 자동 거절이 아니라 실무자 검토 플래그를 생성한다 — 최종 판단은 사람이 한다. [신규 테이블: restriction_rules + rule_violations]</rdfs:comment>
    </owl:Class>

    <!-- ── 어휘·서식·사업 (기관별 이질성 대응) ─────────────── -->

    <owl:Class rdf:about="#Taxonomy">
        <rdfs:label xml:lang="ko">분류체계</rdfs:label>
        <rdfs:label xml:lang="en">Taxonomy</rdfs:label>
        <rdfs:comment xml:lang="ko">지원영역 분류체계 자체를 데이터로 등록. 국내에 단일 표준이 부재하므로 복수 체계를 등록하고 상호 매핑한다. 예: 복지부 8대분류, SIS-A 8영역, 경기 기회소득 5영역, 기관 자체 체계. [신규 테이블: taxonomies]</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#TaxonomyTerm">
        <rdfs:label xml:lang="ko">분류 용어</rdfs:label>
        <rdfs:label xml:lang="en">Taxonomy Term</rdfs:label>
        <rdfs:comment xml:lang="ko">분류체계 내의 개별 지원영역 용어. 대분류-중분류 계층을 self-reference로 표현한다. [신규 테이블: taxonomy_terms + term_mappings]</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#FormDefinition">
        <rdfs:label xml:lang="ko">서식 정의</rdfs:label>
        <rdfs:label xml:lang="en">Form Definition</rdfs:label>
        <rdfs:comment xml:lang="ko">기관·사업별 서식을 데이터로 정의. 섹션·필드·표·매트릭스 구조를 JSON으로 담고, 각 필드가 의미 계층의 무엇에 착지하는지(bind)를 명시한다. 렌더러는 단 하나이며 서식은 데이터로 추가된다 — 새 기관 서식 추가에 컴포넌트 개발이 불필요해진다. [신규 테이블: form_definitions + form_responses]</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Program">
        <rdfs:label xml:lang="ko">사업</rdfs:label>
        <rdfs:label xml:lang="en">Program</rdfs:label>
        <rdfs:comment xml:lang="ko">개인예산 사업 단위(보건복지부 시범사업·서울형·경기 기회소득·재단 공모사업·기관 자체 예산). 사업마다 서식·용처 제한·분류체계·한도가 다르므로 이들을 묶는다. 한 당사자가 복수 사업에 동시 참여하는 것은 이미 현실이다. [신규 테이블: programs, FK: funding_sources.program_id]</rdfs:comment>
    </owl:Class>

    <!-- ======================================================= -->
    <!-- Object Properties (관계 = 화살표)                        -->
    <!-- ======================================================= -->

    <!-- 당사자 → 가치·욕구 (7종). 모두 hasValueNode 의 하위 관계이며,
         당사자를 중심에 둔 방사형 구조가 곧 '삶의 그림(Picture of a Life)' 이다. -->

    <owl:ObjectProperty rdf:about="#hasValueNode">
        <rdfs:label xml:lang="ko">가치·욕구를 가진다 (상위 관계)</rdfs:label>
        <rdfs:domain rdf:resource="#Person"/>
        <rdfs:range rdf:resource="#ValueNode"/>
        <rdfs:comment xml:lang="ko">아래 7개 관계의 상위 관계. 종류를 가리지 않고 "이 사람에 대해 아는 것 전부"를 한 번에 조회할 때 사용한다.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasImportantTo">
        <rdfs:subPropertyOf rdf:resource="#hasValueNode"/>
        <rdfs:label xml:lang="ko">나에게 중요한 것을 가진다</rdfs:label>
        <rdfs:domain rdf:resource="#Person"/>
        <rdfs:range rdf:resource="#ImportantTo"/>
        <rdfs:comment xml:lang="ko">당사자가 삶의 질을 위해 진정으로 원하는 목표와 선호를 매핑</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#requiresImportantFor">
        <rdfs:subPropertyOf rdf:resource="#hasValueNode"/>
        <rdfs:label xml:lang="ko">나를 위해 중요한 것을 필요로 한다</rdfs:label>
        <rdfs:domain rdf:resource="#Person"/>
        <rdfs:range rdf:resource="#ImportantFor"/>
        <rdfs:comment xml:lang="ko">지원자 관점에서 객관적으로 필요한 안전·건강 요소를 매핑. 이 화살표와 위 화살표의 균형이 PCP의 핵심 지표</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasStrength">
        <rdfs:subPropertyOf rdf:resource="#hasValueNode"/>
        <rdfs:label xml:lang="ko">강점을 가진다</rdfs:label>
        <rdfs:domain rdf:resource="#Person"/>
        <rdfs:range rdf:resource="#Strength"/>
        <rdfs:comment xml:lang="ko">당사자가 이미 가지고 있는 재능·기술. 문제 목록이 아니라 자산 목록에서 계획을 시작하기 위한 것</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasDream">
        <rdfs:subPropertyOf rdf:resource="#hasValueNode"/>
        <rdfs:label xml:lang="ko">꿈을 가진다</rdfs:label>
        <rdfs:domain rdf:resource="#Person"/>
        <rdfs:range rdf:resource="#Dream"/>
        <rdfs:comment xml:lang="ko">희망·관심사와 1~2년 내 시도하고 싶은 것. PATH(꿈 찾기) 회의의 산출물이 여기로 들어온다</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#facesBarrier">
        <rdfs:subPropertyOf rdf:resource="#hasValueNode"/>
        <rdfs:label xml:lang="ko">장벽을 마주한다</rdfs:label>
        <rdfs:domain rdf:resource="#Person"/>
        <rdfs:range rdf:resource="#Barrier"/>
        <rdfs:comment xml:lang="ko">"가진다"가 아니라 "마주한다"로 쓴 이유 — 장벽은 당사자의 속성이 아니라 환경이 만든 것이기 때문</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#communicatesVia">
        <rdfs:subPropertyOf rdf:resource="#hasValueNode"/>
        <rdfs:label xml:lang="ko">이렇게 소통한다</rdfs:label>
        <rdfs:domain rdf:resource="#Person"/>
        <rdfs:range rdf:resource="#CommunicationStyle"/>
        <rdfs:comment xml:lang="ko">당사자가 무엇을 어떻게 표현하는지. 말이 적은 당사자일수록 이 노드가 지원의 출발점이 된다</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasSupportApproach">
        <rdfs:subPropertyOf rdf:resource="#hasValueNode"/>
        <rdfs:label xml:lang="ko">이런 지원이 맞다</rdfs:label>
        <rdfs:domain rdf:resource="#Person"/>
        <rdfs:range rdf:resource="#SupportApproach"/>
        <rdfs:comment xml:lang="ko">이 사람에게 잘 맞는 지원 방식과 피해야 할 방식</rdfs:comment>
    </owl:ObjectProperty>

    <!-- 지원자 → 소통 방식·좋은 지원.
         이 두 노드는 당사자가 "가진" 것이면서 동시에 지원자가 "지켜야 할" 것이다.
         당사자에만 연결하면 "실무자가 바뀌어도 지원의 질이 유지된다"는 목적이 그림에서 사라진다. -->

    <owl:ObjectProperty rdf:about="#mustUnderstand">
        <rdfs:label xml:lang="ko">소통 방식을 알아야 한다</rdfs:label>
        <rdfs:domain rdf:resource="#Supporter"/>
        <rdfs:range rdf:resource="#CommunicationStyle"/>
        <rdfs:comment xml:lang="ko">새로 배치된 지원자가 가장 먼저 읽어야 하는 정보. 인수인계의 최소 단위</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#follows">
        <rdfs:label xml:lang="ko">지원 방식을 따른다</rdfs:label>
        <rdfs:domain rdf:resource="#Supporter"/>
        <rdfs:range rdf:resource="#SupportApproach"/>
        <rdfs:comment xml:lang="ko">지원자가 지켜야 할 지침. 이 화살표가 있어야 암묵지가 조직의 자산이 된다</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#makesTransaction">
        <rdfs:label xml:lang="ko">지출을 결정한다</rdfs:label>
        <rdfs:domain rdf:resource="#Person"/>
        <rdfs:range rdf:resource="#Transaction"/>
        <rdfs:comment xml:lang="ko">당사자가 스스로 결정하여 권한을 행사한 구매·서비스 이용 이벤트. [기존 FK: transactions.participant_id]</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#facilitatesPlanFor">
        <rdfs:label xml:lang="ko">계획 수립을 지원한다</rdfs:label>
        <rdfs:domain rdf:resource="#Supporter"/>
        <rdfs:range rdf:resource="#Person"/>
        <rdfs:comment xml:lang="ko">지원자가 당사자의 꿈 찾기 등 PCP 수립 과정을 교육·지원. 계획의 주인은 당사자이고 지원자는 곁에서 돕는 사람이라는 것이 authors 와 이 관계의 차이다. [기존 FK: participants.assigned_supporter_id]</rdfs:comment>
    </owl:ObjectProperty>

    <!-- ═══ 주도성(Self-direction) ═══
         "당사자가 얼마나 주도적으로 계획을 세우고 실행했는가"에 답하기 위한 관계들.
         이전 판에는 당사자에서 계획으로 가는 화살표가 아예 없어, 그림상 계획이
         "가치에서 파생되고 지원자가 지원하는 것"으로만 보였다. 개인예산제의 철학이
         데이터 구조에서 빠져 있던 것이므로 아래 4개 관계로 바로잡는다. -->

    <owl:ObjectProperty rdf:about="#authors">
        <rdfs:label xml:lang="ko">계획을 세운다</rdfs:label>
        <rdfs:domain rdf:resource="#Person"/>
        <rdfs:range rdf:resource="#BudgetPlan"/>
        <rdfs:comment xml:lang="ko">★ 당사자가 자기 개별지원계획의 저자임을 명시하는 관계. 개인예산제에서 계획은 당사자에게 주어지는 것이 아니라 당사자가 만드는 것이다. 실제 수립 과정에서의 주도 수준은 BudgetPlan.selfDirectionLevel 로 구분한다.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#plansMonth">
        <rdfs:label xml:lang="ko">이번 달 계획을 세운다</rdfs:label>
        <rdfs:domain rdf:resource="#Person"/>
        <rdfs:range rdf:resource="#MonthlyPlan"/>
        <rdfs:comment xml:lang="ko">월 단위 주도성. 연간 계획은 지원자와 함께 세웠더라도 매달의 선택은 당사자가 늘어가는 것이 개인예산제의 목표다</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#participatesIn">
        <rdfs:label xml:lang="ko">회의에 참여한다</rdfs:label>
        <rdfs:domain rdf:resource="#Person"/>
        <rdfs:range rdf:resource="#PlanningMeeting"/>
        <rdfs:comment xml:lang="ko">자기 삶에 관한 회의에 당사자가 있었는가. 참여 여부 자체가 주도성의 1차 지표이며, 당사자 없이 진행된 회의는 그 사실이 기록으로 남는다</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#reflectsOn">
        <rdfs:label xml:lang="ko">스스로 돌아본다</rdfs:label>
        <rdfs:domain rdf:resource="#Person"/>
        <rdfs:range rdf:resource="#Evaluation"/>
        <rdfs:comment xml:lang="ko">당사자 자기평가. 평가가 당사자에 '대해' 쓰이는 것이 아니라 당사자가 '하는' 것이 되게 하는 관계</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#isAddressedBy">
        <rdfs:label xml:lang="ko">계획에 반영된다</rdfs:label>
        <rdfs:domain rdf:resource="#ValueNode"/>
        <rdfs:range rdf:resource="#BudgetPlan"/>
        <rdfs:comment xml:lang="ko">도출된 욕구가 개인별지원계획(ISP)의 세부 목표로 반영됨. 이 화살표가 끊긴 가치 노드 = "말은 들었으나 계획에 담기지 않은 것" → 알림 대상. [신규 FK: support_goals.value_node_id]</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#classifiedAs">
        <rdfs:label xml:lang="ko">지원영역으로 분류된다</rdfs:label>
        <rdfs:domain rdf:resource="#ValueNode"/>
        <rdfs:range rdf:resource="#TaxonomyTerm"/>
        <rdfs:comment xml:lang="ko">가치·욕구가 특정 분류체계의 지원영역 용어에 매핑됨(복지부 8대분류 / SIS-A 8영역 등). [신규 FK: support_goals.support_area_term_id]</rdfs:comment>
    </owl:ObjectProperty>

    <!-- ═══ 과정과 근거 ═══
         가치·욕구는 저절로 생기지 않는다. 회의에서 나오고 사정으로 뒷받침된다. -->

    <owl:ObjectProperty rdf:about="#facilitatesMeeting">
        <rdfs:label xml:lang="ko">회의를 진행한다</rdfs:label>
        <rdfs:domain rdf:resource="#Supporter"/>
        <rdfs:range rdf:resource="#PlanningMeeting"/>
        <rdfs:comment xml:lang="ko">지원자의 역할은 퍼실리테이터다 — 회의를 여는 사람이지 결정하는 사람이 아니다</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#attends">
        <rdfs:label xml:lang="ko">회의에 함께한다</rdfs:label>
        <rdfs:domain rdf:resource="#NetworkEntity"/>
        <rdfs:range rdf:resource="#PlanningMeeting"/>
        <rdfs:comment xml:lang="ko">PCD는 당사자를 잘 아는 주변 사람들이 함께 모여 하는 것이다. 누가 왔는지가 기록되면 "이 사람의 삶을 누가 함께 그렸는가"를 알 수 있고, 유급 지원자만 앉아 있는 회의는 그 자체가 신호가 된다</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#producesValue">
        <rdfs:label xml:lang="ko">이 회의에서 알게 되었다</rdfs:label>
        <rdfs:domain rdf:resource="#PlanningMeeting"/>
        <rdfs:range rdf:resource="#ValueNode"/>
        <rdfs:comment xml:lang="ko">회의의 산출물이 곧 가치·욕구 노드. 어느 회의에서 나온 이야기인지 추적되므로 "언제부터 이렇게 알고 있었나"를 되짚을 수 있다</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#producesPlan">
        <rdfs:label xml:lang="ko">이 회의에서 계획이 나왔다</rdfs:label>
        <rdfs:domain rdf:resource="#PlanningMeeting"/>
        <rdfs:range rdf:resource="#BudgetPlan"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#assessedBy">
        <rdfs:label xml:lang="ko">지원요구를 사정받는다</rdfs:label>
        <rdfs:domain rdf:resource="#Person"/>
        <rdfs:range rdf:resource="#SupportNeedsAssessment"/>
        <rdfs:comment xml:lang="ko">SIS-A 평가. PCD가 "무엇을 원하는가"라면 SIS-A는 "어디에 얼마나 지원이 필요한가"를 측정한다</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#indicatesNeedIn">
        <rdfs:label xml:lang="ko">이 영역에 지원이 필요하다</rdfs:label>
        <rdfs:domain rdf:resource="#SupportNeedsAssessment"/>
        <rdfs:range rdf:resource="#TaxonomyTerm"/>
        <rdfs:comment xml:lang="ko">사정 결과를 지원영역 분류체계(SIS-A 8영역 등)에 연결. 어휘 계층을 거치므로 복지부 8대분류로도 환산해 볼 수 있다</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#informs">
        <rdfs:label xml:lang="ko">계획의 근거가 된다</rdfs:label>
        <rdfs:domain rdf:resource="#SupportNeedsAssessment"/>
        <rdfs:range rdf:resource="#BudgetPlan"/>
        <rdfs:comment xml:lang="ko">"왜 이 계획인가"의 객관적 근거. 이 화살표가 없으면 계획이 사정과 무관하게 세워졌다는 뜻이다</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#breaksDownInto">
        <rdfs:label xml:lang="ko">월별 계획으로 나뉜다</rdfs:label>
        <rdfs:domain rdf:resource="#BudgetPlan"/>
        <rdfs:range rdf:resource="#MonthlyPlan"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#executedBy">
        <rdfs:label xml:lang="ko">이렇게 실행되었다</rdfs:label>
        <rdfs:domain rdf:resource="#MonthlyPlan"/>
        <rdfs:range rdf:resource="#Transaction"/>
        <rdfs:comment xml:lang="ko">계획과 실제 지출의 연결. [기존 FK: transactions.monthly_plan_id]</rdfs:comment>
    </owl:ObjectProperty>

    <!-- ═══ 순환 고리 — "무엇이 달라졌는가"에 답하는 부분 ═══
         PCT의 핵심은 실행에서 배운 것이 다시 앎으로 돌아오는 것이다.
         evaluatesPlan → producesLearning 이 그 고리를 닫는다. -->

    <owl:ObjectProperty rdf:about="#recordsEvaluation">
        <rdfs:label xml:lang="ko">평가를 기록한다</rdfs:label>
        <rdfs:domain rdf:resource="#Supporter"/>
        <rdfs:range rdf:resource="#Evaluation"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#evaluatesPlan">
        <rdfs:label xml:lang="ko">계획이 어떻게 되었는지 본다</rdfs:label>
        <rdfs:domain rdf:resource="#Evaluation"/>
        <rdfs:range rdf:resource="#MonthlyPlan"/>
        <rdfs:comment xml:lang="ko">4+1 질문 중 "시도한 것"에 해당. 계획 대비 실제를 확인한다</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#producesLearning">
        <rdfs:label xml:lang="ko">평가에서 새로 알게 되었다</rdfs:label>
        <rdfs:domain rdf:resource="#Evaluation"/>
        <rdfs:range rdf:resource="#ValueNode"/>
        <rdfs:comment xml:lang="ko">★ **이 화살표가 순환을 닫는다.** 4+1의 "배운 것"이 새로운 가치·욕구 노드가 되어 다음 계획의 입력이 된다. 사람중심생각의 배움 기록(Learning Log)이 하는 일이며, 이 고리가 없으면 평가는 서류로 끝나고 앎은 갱신되지 않는다. 예: "수영은 좋아하는데 사람 많은 시간은 힘들어한다"는 배움 → 새 SupportApproach 노드</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#capturesSnapshot">
        <rdfs:label xml:lang="ko">그 시점의 지표를 남긴다</rdfs:label>
        <rdfs:domain rdf:resource="#Evaluation"/>
        <rdfs:range rdf:resource="#OutcomeSnapshot"/>
        <rdfs:comment xml:lang="ko">월별 평가 시점에 To/For 균형·관계 지도 분면·주도성 비율을 자동 계산해 고정한다. 실무자의 추가 입력은 없다</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasSnapshot">
        <rdfs:label xml:lang="ko">시점별 성과 기록을 가진다</rdfs:label>
        <rdfs:domain rdf:resource="#Person"/>
        <rdfs:range rdf:resource="#OutcomeSnapshot"/>
        <rdfs:comment xml:lang="ko">연 12개 시점이 쌓이면 "3월 대비 12월에 친구가 2명 늘었고 주도성 비율이 30%에서 70%가 되었다"를 말할 수 있다</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#strengthSupports">
        <rdfs:label xml:lang="ko">강점이 계획을 뒷받침한다</rdfs:label>
        <rdfs:domain rdf:resource="#Strength"/>
        <rdfs:range rdf:resource="#BudgetPlan"/>
        <rdfs:comment xml:lang="ko">다른 가치 노드는 "계획에 반영된다"(= 해결 대상)로 계획과 이어지지만, 강점은 해결할 욕구가 아니라 **활용할 자산**이므로 방향이 다르다. 강점 기반 실천에서 계획은 결핍이 아니라 강점 위에 세워진다.</rdfs:comment>
    </owl:ObjectProperty>

    <!-- 당사자 → 관계 지도 4분면.
         분면을 나누는 목적은 분류가 아니라 관계의 균형(off balance) 확인이다. -->

    <owl:ObjectProperty rdf:about="#hasFamilyMember">
        <rdfs:label xml:lang="ko">가족이 있다</rdfs:label>
        <rdfs:domain rdf:resource="#Person"/>
        <rdfs:range rdf:resource="#Family"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasFriend">
        <rdfs:label xml:lang="ko">친구가 있다</rdfs:label>
        <rdfs:domain rdf:resource="#Person"/>
        <rdfs:range rdf:resource="#Friend"/>
        <rdfs:comment xml:lang="ko">스스로 선택한 무급 관계. 이 화살표가 없는 것이 가장 흔한 고립 양상이며, 관계 지도를 그리는 가장 큰 이유이기도 하다</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#receivesPaidSupportFrom">
        <rdfs:label xml:lang="ko">유급 지원을 받는다</rdfs:label>
        <rdfs:domain rdf:resource="#Person"/>
        <rdfs:range rdf:resource="#PaidSupport"/>
        <rdfs:comment xml:lang="ko">이 화살표만 많고 가족·친구·지역사회 화살표가 적으면 = 삶에 돈 받고 오는 사람만 있다 = 고립 위험</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#knowsFromCommunity">
        <rdfs:label xml:lang="ko">지역사회에서 만난다</rdfs:label>
        <rdfs:domain rdf:resource="#Person"/>
        <rdfs:range rdf:resource="#CommunityMember"/>
        <rdfs:comment xml:lang="ko">직장·학교·단골 가게 등에서 일상적으로 마주치는 사람. 친구로 발전할 수 있는 접점이므로 지역사회 통합의 씨앗으로 본다</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#allocatesFundsTo">
        <rdfs:label xml:lang="ko">예산을 배정한다</rdfs:label>
        <rdfs:domain rdf:resource="#BudgetPlan"/>
        <rdfs:range rdf:resource="#ServiceResource"/>
        <rdfs:comment xml:lang="ko">승인된 예산이 어느 제공기관·용처에 얼마 할당되었는지. 배정액이 이 화살표의 가중치. [신규 FK: budget_line_items.service_resource_id]</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#isSpentAt">
        <rdfs:label xml:lang="ko">여기서 사용됐다</rdfs:label>
        <rdfs:domain rdf:resource="#Transaction"/>
        <rdfs:range rdf:resource="#ServiceResource"/>
        <rdfs:comment xml:lang="ko">실제 예산이 사용된 지역사회 기관·품목 연결. [신규 FK: transactions.service_resource_id]</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#violatesRule">
        <rdfs:label xml:lang="ko">규칙에 저촉된다 (조건부)</rdfs:label>
        <rdfs:domain rdf:resource="#Transaction"/>
        <rdfs:range rdf:resource="#RestrictionRule"/>
        <rdfs:comment xml:lang="ko">집행 내역이 오남용 제한 규칙에 저촉되는지 룰 엔진이 검사. 자동 거절이 아니라 실무자 검토 플래그를 만든다. [신규 테이블: rule_violations]</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#reportsStatusOf">
        <rdfs:label xml:lang="ko">안부를 전한다</rdfs:label>
        <rdfs:domain rdf:resource="#NetworkEntity"/>
        <rdfs:range rdf:resource="#Person"/>
        <rdfs:comment xml:lang="ko">지역 네트워크가 당사자의 상태 변화·안부를 간접 제보·연결. 이 화살표의 소멸(3개월 이상 무접촉)은 단순 기록 누락이 아니라 고립 신호로 해석한다.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasTerm">
        <rdfs:label xml:lang="ko">용어를 포함한다</rdfs:label>
        <rdfs:domain rdf:resource="#Taxonomy"/>
        <rdfs:range rdf:resource="#TaxonomyTerm"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasChildTerm">
        <rdfs:label xml:lang="ko">하위 용어를 가진다</rdfs:label>
        <rdfs:domain rdf:resource="#TaxonomyTerm"/>
        <rdfs:range rdf:resource="#TaxonomyTerm"/>
        <rdfs:comment xml:lang="ko">대분류 → 중분류 계층 (예: 신체적 건강 → 건강증진 / 재활 / 장애인보조기기)</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#mapsTo">
        <rdfs:label xml:lang="ko">다른 체계의 용어에 대응된다</rdfs:label>
        <rdfs:domain rdf:resource="#TaxonomyTerm"/>
        <rdfs:range rdf:resource="#TaxonomyTerm"/>
        <rdfs:comment xml:lang="ko">체계 간 상호 매핑(crosswalk). exact / broader / narrower / related 로 대응 강도를 표시하며, 1:1이 아니고 손실이 발생하므로 자동 변환 결과는 실무자 확인을 거친다. 사업이 달라도 동일 기준으로 성과를 집계·비교할 수 있게 하는 장치. [신규 테이블: term_mappings]</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#usesTaxonomy">
        <rdfs:label xml:lang="ko">분류체계를 사용한다</rdfs:label>
        <rdfs:domain rdf:resource="#FormDefinition"/>
        <rdfs:range rdf:resource="#Taxonomy"/>
        <rdfs:comment xml:lang="ko">matrix 타입 필드가 참조할 분류체계 (복지부형 8대분류 욕구사정 매트릭스)</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#projectsFrom">
        <rdfs:label xml:lang="ko">의미 계층에서 투영된다</rdfs:label>
        <rdfs:domain rdf:resource="#FormDefinition"/>
        <rdfs:range rdf:resource="#ValueNode"/>
        <rdfs:comment xml:lang="ko">서식 출력 시 의미 계층의 가치·목표·예산에서 값을 채워 넣는다. 이것이 "한 번 입력, 여러 양식 출력"의 실체. bind 없는 서식 고유 행정 필드는 form_responses.extras 에 원본 보존하여 온톨로지를 오염시키지 않는다.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#requiresForm">
        <rdfs:label xml:lang="ko">서식을 요구한다</rdfs:label>
        <rdfs:domain rdf:resource="#Program"/>
        <rdfs:range rdf:resource="#FormDefinition"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#enforcesRule">
        <rdfs:label xml:lang="ko">제한 규칙을 적용한다</rdfs:label>
        <rdfs:domain rdf:resource="#Program"/>
        <rdfs:range rdf:resource="#RestrictionRule"/>
        <rdfs:comment xml:lang="ko">사업마다 허용 영역·금지 품목이 다르다 (경기 기회소득 5영역 허용 vs 복지부 주류·담배 배제)</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#classifiesBy">
        <rdfs:label xml:lang="ko">분류체계를 따른다</rdfs:label>
        <rdfs:domain rdf:resource="#Program"/>
        <rdfs:range rdf:resource="#Taxonomy"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#funds">
        <rdfs:label xml:lang="ko">예산 계획에 재원을 제공한다</rdfs:label>
        <rdfs:domain rdf:resource="#Program"/>
        <rdfs:range rdf:resource="#BudgetPlan"/>
        <rdfs:comment xml:lang="ko">기존 funding_sources 를 통해 연결. 한 당사자가 복수 사업의 재원을 동시에 쓰는 경우를 표현한다 (예: 재단 사업 920,000원 + 기관 예산 580,000원)</rdfs:comment>
    </owl:ObjectProperty>

    <!-- ======================================================= -->
    <!-- Data Properties (속성)                                   -->
    <!-- ======================================================= -->

    <!-- Person -->
    <owl:DatatypeProperty rdf:about="#personName">
        <rdfs:label xml:lang="ko">이름</rdfs:label>
        <rdfs:domain rdf:resource="#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#budgetStartDate">
        <rdfs:label xml:lang="ko">예산 시작일</rdfs:label>
        <rdfs:domain rdf:resource="#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#budgetEndDate">
        <rdfs:label xml:lang="ko">예산 종료일</rdfs:label>
        <rdfs:domain rdf:resource="#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#yearlyBudget">
        <rdfs:label xml:lang="ko">연간 예산</rdfs:label>
        <rdfs:domain rdf:resource="#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <!-- Supporter -->
    <owl:DatatypeProperty rdf:about="#supporterName">
        <rdfs:label xml:lang="ko">이름</rdfs:label>
        <rdfs:domain rdf:resource="#Supporter"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#supporterRole">
        <rdfs:label xml:lang="ko">역할</rdfs:label>
        <rdfs:domain rdf:resource="#Supporter"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <!-- NetworkEntity -->
    <owl:DatatypeProperty rdf:about="#entityName">
        <rdfs:label xml:lang="ko">이름</rdfs:label>
        <rdfs:domain rdf:resource="#NetworkEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#relationType">
        <rdfs:label xml:lang="ko">관계 유형 (가족·이웃·친구·동료·기타)</rdfs:label>
        <rdfs:domain rdf:resource="#NetworkEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#lastContactDate">
        <rdfs:label xml:lang="ko">마지막 접촉일</rdfs:label>
        <rdfs:domain rdf:resource="#NetworkEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="ko">고립 위험 계산의 입력값</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#closeness">
        <rdfs:label xml:lang="ko">친밀도 (1~4)</rdfs:label>
        <rdfs:domain rdf:resource="#NetworkEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="ko">1=가장 가까움. 관계 지도를 동심원으로 그릴 때 당사자로부터의 거리가 된다. 4분면(누구인가) × 동심원(얼마나 가까운가)의 조합이 관계 지도의 완성형</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#contactFrequency">
        <rdfs:label xml:lang="ko">만나는 빈도</rdfs:label>
        <rdfs:domain rdf:resource="#NetworkEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="ko">주 1회 / 월 1회 / 연 몇 회 등. 빈도가 줄어드는 추세가 관계 소멸의 조기 신호</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- ValueNode (하위 클래스가 모두 상속) -->
    <owl:DatatypeProperty rdf:about="#valueLabel">
        <rdfs:label xml:lang="ko">이름표</rdfs:label>
        <rdfs:domain rdf:resource="#ValueNode"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="ko">예: "수영을 계속하고 싶다"</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#valueWeight">
        <rdfs:label xml:lang="ko">가중치 (0~5)</rdfs:label>
        <rdfs:domain rdf:resource="#ValueNode"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="ko">To/For 균형 지수 계산에 사용</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#valueEasyDescription">
        <rdfs:label xml:lang="ko">쉬운 설명</rdfs:label>
        <rdfs:domain rdf:resource="#ValueNode"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="ko">당사자가 읽는 Easy Read 문장. 신규 엔티티는 처음부터 쉬운 정보 필드를 갖는다</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#valueEasyImageUrl">
        <rdfs:label xml:lang="ko">쉬운 그림</rdfs:label>
        <rdfs:domain rdf:resource="#ValueNode"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="ko">"삶의 그림" 화면에서 노드를 대표하는 사진</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#valueStatus">
        <rdfs:label xml:lang="ko">상태 (active·archived)</rdfs:label>
        <rdfs:domain rdf:resource="#ValueNode"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#sourceFormField">
        <rdfs:label xml:lang="ko">출처 서식 필드</rdfs:label>
        <rdfs:domain rdf:resource="#ValueNode"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="ko">어느 기관 서식의 어느 질문에서 도출되었는지 추적 (예: seoul_plan.talents). 원래 서식으로 되돌려 출력할 때 사용</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- ServiceResource -->
    <owl:DatatypeProperty rdf:about="#resourceName">
        <rdfs:label xml:lang="ko">이름</rdfs:label>
        <rdfs:domain rdf:resource="#ServiceResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#resourceCategory">
        <rdfs:label xml:lang="ko">분류 (카페·수영장·병원 등)</rdfs:label>
        <rdfs:domain rdf:resource="#ServiceResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#kakaoPlaceId">
        <rdfs:label xml:lang="ko">카카오 장소 ID</rdfs:label>
        <rdfs:domain rdf:resource="#ServiceResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="ko">중복 자원 병합 키</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#isVerified">
        <rdfs:label xml:lang="ko">실무자 확인 여부</rdfs:label>
        <rdfs:domain rdf:resource="#ServiceResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#riskTags">
        <rdfs:label xml:lang="ko">위험 태그 (주류·사행성 등)</rdfs:label>
        <rdfs:domain rdf:resource="#ServiceResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="ko">룰 엔진이 참조하는 속성</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- BudgetPlan -->
    <owl:DatatypeProperty rdf:about="#planYear">
        <rdfs:label xml:lang="ko">계획 연도</rdfs:label>
        <rdfs:domain rdf:resource="#BudgetPlan"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#stage">
        <rdfs:label xml:lang="ko">진행 단계 (7단계)</rdfs:label>
        <rdfs:domain rdf:resource="#BudgetPlan"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="ko">신청 → 욕구상담 → 계획작성 → 심의승인 → 지급 → 집행모니터링 → 정산평가. 당사자 화면에는 3단계로 축약 표시 ("계획 만들어요 → 돈을 써요 → 같이 돌아봐요")</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#totalAmount">
        <rdfs:label xml:lang="ko">총 예산</rdfs:label>
        <rdfs:domain rdf:resource="#BudgetPlan"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="ko">아름드리 시범사업 기준 연 150만원</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#selfDirectionLevel">
        <rdfs:label xml:lang="ko">계획 수립의 주도 수준</rdfs:label>
        <rdfs:domain rdf:resource="#BudgetPlan"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="ko">participant_led(당사자 주도) / co_produced(함께 만듦) / supporter_led(지원자 주도). 계획의 저자는 언제나 당사자(authors)이지만, 실제 수립 과정에서 얼마나 주도했는지는 별개이며 시간이 지나며 올라가야 할 값이다</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Transaction -->
    <owl:DatatypeProperty rdf:about="#transactionDate">
        <rdfs:label xml:lang="ko">날짜</rdfs:label>
        <rdfs:domain rdf:resource="#Transaction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#activityName">
        <rdfs:label xml:lang="ko">활동명</rdfs:label>
        <rdfs:domain rdf:resource="#Transaction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#amount">
        <rdfs:label xml:lang="ko">금액</rdfs:label>
        <rdfs:domain rdf:resource="#Transaction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#transactionStatus">
        <rdfs:label xml:lang="ko">상태 (pending·confirmed)</rdfs:label>
        <rdfs:domain rdf:resource="#Transaction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#decidedBy">
        <rdfs:label xml:lang="ko">누가 결정했나</rdfs:label>
        <rdfs:domain rdf:resource="#Transaction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="ko">self(스스로) / self_with_support(당사자가 정하고 도움받음) / suggested_accepted(제안받아 선택) / supporter(지원자 결정). **당사자 화면에서 등록된 거래는 self 로 자동 추정**하고, 실무자가 영수증 검토 대기열에서 필요할 때만 조정한다 — 매 거래 입력을 강요하지 않는다. 이 값의 분포가 곧 주도성 비율이 된다</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- PlanningMeeting -->
    <owl:DatatypeProperty rdf:about="#meetingKind">
        <rdfs:label xml:lang="ko">회의 종류</rdfs:label>
        <rdfs:domain rdf:resource="#PlanningMeeting"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="ko">pcd(사람중심설명) / path(꿈 찾기) / plan_making(계획 수립) / review(평가회)</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#meetingDate">
        <rdfs:label xml:lang="ko">일시</rdfs:label>
        <rdfs:domain rdf:resource="#PlanningMeeting"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#participantAttended">
        <rdfs:label xml:lang="ko">당사자 참석 여부</rdfs:label>
        <rdfs:domain rdf:resource="#PlanningMeeting"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="ko">자기 삶에 관한 회의에 당사자가 없었다면 그 사실이 기록되어야 한다</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#participantRole">
        <rdfs:label xml:lang="ko">회의에서 당사자의 역할</rdfs:label>
        <rdfs:domain rdf:resource="#PlanningMeeting"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="ko">led(직접 이끎) / spoke(의견을 말함) / present(자리에 있었음) / absent(불참). 참석했다고 다 같은 참여가 아니다</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- SupportNeedsAssessment (SIS-A) -->
    <owl:DatatypeProperty rdf:about="#assessedAt">
        <rdfs:label xml:lang="ko">사정일</rdfs:label>
        <rdfs:domain rdf:resource="#SupportNeedsAssessment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#totalStandardScore">
        <rdfs:label xml:lang="ko">총 표준점수</rdfs:label>
        <rdfs:domain rdf:resource="#SupportNeedsAssessment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#supportNeedsIndex">
        <rdfs:label xml:lang="ko">지원요구 지수</rdfs:label>
        <rdfs:domain rdf:resource="#SupportNeedsAssessment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="ko">[기존 컬럼: sis_assessments.index_score, percentile]</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- MonthlyPlan -->
    <owl:DatatypeProperty rdf:about="#planMonth">
        <rdfs:label xml:lang="ko">계획 월</rdfs:label>
        <rdfs:domain rdf:resource="#MonthlyPlan"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#planTitle">
        <rdfs:label xml:lang="ko">계획 제목</rdfs:label>
        <rdfs:domain rdf:resource="#MonthlyPlan"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="ko">예: "카페 4회 가기"</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#plannedBudget">
        <rdfs:label xml:lang="ko">계획 예산</rdfs:label>
        <rdfs:domain rdf:resource="#MonthlyPlan"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <!-- Evaluation (4+1) -->
    <owl:DatatypeProperty rdf:about="#evaluationMonth">
        <rdfs:label xml:lang="ko">평가 월</rdfs:label>
        <rdfs:domain rdf:resource="#Evaluation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#tried">
        <rdfs:label xml:lang="ko">시도한 것</rdfs:label>
        <rdfs:domain rdf:resource="#Evaluation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#learned">
        <rdfs:label xml:lang="ko">배운 것</rdfs:label>
        <rdfs:domain rdf:resource="#Evaluation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="ko">여기 적힌 것이 producesLearning 을 통해 새 가치·욕구 노드가 된다</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#satisfied">
        <rdfs:label xml:lang="ko">만족한 것</rdfs:label>
        <rdfs:domain rdf:resource="#Evaluation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#dissatisfied">
        <rdfs:label xml:lang="ko">불만족한 것</rdfs:label>
        <rdfs:domain rdf:resource="#Evaluation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#nextPlan">
        <rdfs:label xml:lang="ko">향후 계획</rdfs:label>
        <rdfs:domain rdf:resource="#Evaluation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#writtenByParticipant">
        <rdfs:label xml:lang="ko">당사자가 직접 쓴 평가인가</rdfs:label>
        <rdfs:domain rdf:resource="#Evaluation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="ko">평가가 당사자에 '대해' 쓰인 것인지 당사자가 '한' 것인지를 구분한다</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- OutcomeSnapshot — 변화 측정의 실체 -->
    <owl:DatatypeProperty rdf:about="#snapshotMonth">
        <rdfs:label xml:lang="ko">기준 월</rdfs:label>
        <rdfs:domain rdf:resource="#OutcomeSnapshot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#balanceIndex">
        <rdfs:label xml:lang="ko">To/For 균형 지수 (−1~+1)</rdfs:label>
        <rdfs:domain rdf:resource="#OutcomeSnapshot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="ko">−1이면 전부 "나를 위해 중요한 것"(보호주의 편중), +1이면 전부 "나에게 중요한 것". 0 근처가 균형. 이 값이 SQL 뷰에만 있던 것에서 시점별로 고정 저장되어 추이를 볼 수 있게 된다</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#selfDirectedRatio">
        <rdfs:label xml:lang="ko">주도성 비율</rdfs:label>
        <rdfs:domain rdf:resource="#OutcomeSnapshot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="ko">당사자가 주도해 결정한 지출액 / 전체 집행액. 개인예산제의 핵심 성과 지표이며, 이 값이 오르는 것이 사업의 목표다</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#unpaidRatio">
        <rdfs:label xml:lang="ko">무급 관계 비율</rdfs:label>
        <rdfs:domain rdf:resource="#OutcomeSnapshot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="ko">(가족+친구+지역사회) / 전체 관계. 낮으면 삶에 돈 받고 오는 사람만 있다는 뜻</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#friendCount">
        <rdfs:label xml:lang="ko">친구 수</rdfs:label>
        <rdfs:domain rdf:resource="#OutcomeSnapshot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="ko">관계 지도 4분면 중 가장 늘기 어렵고, 늘었다면 가장 의미 있는 숫자</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#distinctResourceCount">
        <rdfs:label xml:lang="ko">방문 자원 다양도</rdfs:label>
        <rdfs:domain rdf:resource="#OutcomeSnapshot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="ko">그 달에 방문한 서로 다른 지역사회 자원의 수. 생활 반경이 넓어졌는지를 본다</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- RestrictionRule -->
    <owl:DatatypeProperty rdf:about="#ruleName">
        <rdfs:label xml:lang="ko">규칙 이름</rdfs:label>
        <rdfs:domain rdf:resource="#RestrictionRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#ruleType">
        <rdfs:label xml:lang="ko">규칙 유형</rdfs:label>
        <rdfs:domain rdf:resource="#RestrictionRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="ko">키워드 차단 / 카테고리 차단 / 단건 한도 / 월별 카테고리 한도 / 자원 위험태그 / 빈도 한도</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#severity">
        <rdfs:label xml:lang="ko">심각도 (info·warn·block)</rdfs:label>
        <rdfs:domain rdf:resource="#RestrictionRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#easyMessage">
        <rdfs:label xml:lang="ko">당사자용 쉬운 안내 문구</rdfs:label>
        <rdfs:domain rdf:resource="#RestrictionRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="ko">비낙인 원칙 — 금지·위반·오남용 같은 어휘를 배제한다. 기본형: "이 지출은 선생님과 같이 확인해요"</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Taxonomy -->
    <owl:DatatypeProperty rdf:about="#taxonomyCode">
        <rdfs:label xml:lang="ko">코드 (mohw_2024·sis_a·gyeonggi_5)</rdfs:label>
        <rdfs:domain rdf:resource="#Taxonomy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#taxonomyName">
        <rdfs:label xml:lang="ko">이름</rdfs:label>
        <rdfs:domain rdf:resource="#Taxonomy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#taxonomySource">
        <rdfs:label xml:lang="ko">출처 (보건복지부·AAIDD·지자체·기관자체)</rdfs:label>
        <rdfs:domain rdf:resource="#Taxonomy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <!-- TaxonomyTerm -->
    <owl:DatatypeProperty rdf:about="#termCode">
        <rdfs:label xml:lang="ko">코드</rdfs:label>
        <rdfs:domain rdf:resource="#TaxonomyTerm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#termLabel">
        <rdfs:label xml:lang="ko">표시 이름</rdfs:label>
        <rdfs:domain rdf:resource="#TaxonomyTerm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="ko">예: "건강 및 안전 활동"(SIS-A), "신체적 건강"(복지부)</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#mappingRelation">
        <rdfs:label xml:lang="ko">대응 관계 (exact·broader·narrower·related)</rdfs:label>
        <rdfs:domain rdf:resource="#TaxonomyTerm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="ko">mapsTo 화살표의 강도. 집계·비교 시 exact 만 쓸지 broader 까지 포함할지 보고서마다 선택한다</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- FormDefinition -->
    <owl:DatatypeProperty rdf:about="#formCode">
        <rdfs:label xml:lang="ko">코드 (mohw_plan·seoul_plan 등)</rdfs:label>
        <rdfs:domain rdf:resource="#FormDefinition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#formKind">
        <rdfs:label xml:lang="ko">종류 (이용계획서·평가·신청서·정산)</rdfs:label>
        <rdfs:domain rdf:resource="#FormDefinition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#formVersion">
        <rdfs:label xml:lang="ko">버전</rdfs:label>
        <rdfs:domain rdf:resource="#FormDefinition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="ko">제도 개편으로 서식이 바뀌어도 과거 문서를 원형대로 재출력할 수 있게 한다</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#formSchema">
        <rdfs:label xml:lang="ko">서식 스키마 (JSON)</rdfs:label>
        <rdfs:domain rdf:resource="#FormDefinition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="ko">sections[].fields[] — type(text·textarea·boolean·radio·checkbox·date·number·table·matrix·signature), label, columns[], taxonomy, bind{target,kind}</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Program -->
    <owl:DatatypeProperty rdf:about="#programCode">
        <rdfs:label xml:lang="ko">코드</rdfs:label>
        <rdfs:domain rdf:resource="#Program"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#programName">
        <rdfs:label xml:lang="ko">사업명</rdfs:label>
        <rdfs:domain rdf:resource="#Program"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#programOperator">
        <rdfs:label xml:lang="ko">운영 주체</rdfs:label>
        <rdfs:domain rdf:resource="#Program"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="ko">보건복지부 / 서울시 / 아산사회복지재단 / 기관 자체</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#budgetCeiling">
        <rdfs:label xml:lang="ko">한도액</rdfs:label>
        <rdfs:domain rdf:resource="#Program"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="ko">예: 서울형 2,400,000원 (월 400,000원)</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#periodStart">
        <rdfs:label xml:lang="ko">사업 시작일</rdfs:label>
        <rdfs:domain rdf:resource="#Program"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#periodEnd">
        <rdfs:label xml:lang="ko">사업 종료일</rdfs:label>
        <rdfs:domain rdf:resource="#Program"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>

</rdf:RDF>
