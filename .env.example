# 서울형 개인예산제 앱 — 환경변수
# 값을 채운 뒤 .env.local 로 복사해서 씁니다. (.env.local 은 git에 올라가지 않습니다.)

# ── Supabase ────────────────────────────────────────────────────────
# 프로젝트 리전은 반드시 Seoul(ap-northeast-2)로 생성하세요 — 나중에 못 바꿉니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 클라이언트에 노출되지 않아야 하며 NEXT_PUBLIC_ 접두어를 붙이지 않습니다.
SUPABASE_SERVICE_ROLE_KEY=

# ── 로그인 ──────────────────────────────────────────────────────────
# 배포 도메인. 프리뷰 배포에서는 비워둬도 x-forwarded-host 로 대체됩니다.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# 첫 로그인 시 무조건 관리자로 지정할 이메일 (부트스트랩 탈출구). 필수는 아니지만 강력 권장.
SUPER_ADMIN_EMAIL=
# 이 도메인 이메일은 실무자로 자동 인식됩니다. 쉼표로 여러 개. 미설정 시 아무 도메인도 자동 허용되지 않습니다.
ALLOWED_EMAIL_DOMAINS=

# ── 데모 로그인 (선택) ───────────────────────────────────────────────
# true 로 켜면 /login 에 데모 계정 버튼이 나타납니다. 계정은 실제 Supabase Auth 계정이며
# scripts/seed-demo-auth.mjs 로 미리 만들어야 합니다. 아래 6개 값과 정확히 일치해야 합니다.
NEXT_PUBLIC_DEMO_LOGIN_ENABLED=false
DEMO_ADMIN_EMAIL=demo.admin@example.com
DEMO_ADMIN_PASSWORD=
DEMO_SUPPORTER_EMAIL=demo.supporter@example.com
DEMO_SUPPORTER_PASSWORD=
DEMO_PARTICIPANT_EMAIL=demo.participant@example.com
DEMO_PARTICIPANT_PASSWORD=

# ── 선택 기능 (없어도 앱은 정상 동작, 해당 기능만 비활성화) ─────────────
# 영수증 OCR·AI 요약
OPENAI_API_KEY=
# 카카오 지도. JS SDK 키는 배포 도메인을 Kakao Developers > 플랫폼 > Web 에 등록해야 동작합니다.
NEXT_PUBLIC_KAKAO_MAP_API_KEY=
KAKAO_REST_API_KEY=
